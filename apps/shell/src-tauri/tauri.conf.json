{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nekodex",
  "version": "0.1.0",
  "identifier": "dev.nekodex.workbench",
  "build": {
    "beforeBuildCommand": {
      "script": "node tools/build-frontend.mjs",
      "cwd": "../../.."
    },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nekodex",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "resources": {
      "../../../LICENSE": "LICENSE"
    },
    "android": {
      "minSdkVersion": 29
    }
  }
}
